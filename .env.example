# Koneksi database portal (dittek).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dittek

# Folder berkas dokumen (hasil `npm run mirror-files`). Kosong = ./files.
FILES_DIR=

# Folder unggahan admin, tampil tanpa build ulang. Kosong = ./uploads.
#   <UPLOAD_DIR>/kalender/  gambar kalender kerja (.jpg/.png/.webp) — yang
#                           tampil = berkas terbaru
UPLOAD_DIR=

# Lama data DB portal di-cache (detik). Kosong = 300. 0 = tanpa cache.
CACHE_TTL_SECONDS=

# Server production (npm start / pm2 — lihat ecosystem.config.cjs). JANGAN biarkan
# baris ini kosong ("ORIGIN=") — server gagal start. Hapus tanda # lalu isi alamat
# yang diketik pengguna. PORT default 3000; 80 bila menggantikan portal lama.
# ORIGIN=http://portalditek.indonesian-aerospace.com
# PORT=80

# Database IMS (Program R&D) — user read-only, lihat README. Kosong = bagian
# Program R&D disembunyikan.
IMS_DB_HOST=
IMS_DB_PORT=
IMS_DB_USER=
IMS_DB_PASSWORD=
IMS_DB_NAME=
# Alamat web IMS untuk tautan "Buka di IMS". Kosong = http://10.1.95.116:81
PUBLIC_IMS_URL=
# Folder gambar program (kolom programs.image, yang dipakai nama file-nya).
# Ini URL yang dibuka BROWSER, bukan path folder di server — jangan isi
# /var/www/ims/assets/images (hasilnya 404). Kosong = /gambar/ims/assets/images
# (salinan di static). Untuk ambil langsung dari web IMS (port 81):
# http://10.1.95.116:81/assets/images
PUBLIC_IMS_IMAGE_URL=http://10.1.95.116:81/assets/images

# Alamat server portal lama (PHP) & sub-sistemnya. Opsional — kosong = default
# di src/lib/config/legacy.ts (server baru 10.1.95.116). Bila server pindah lagi,
# ganti di sini lalu restart (tanpa rebuild). PUBLIC_* ikut terkirim ke browser.
# Bila portal ini mengambil port 80 dan portal lama dipindah (mis. ke 8080), isi
# http://10.1.95.116:8080 — dipakai /unduh untuk berkas yang belum ada di FILES_DIR.
PUBLIC_LEGACY_PORTAL_URL=
PUBLIC_DOA_URL=
PUBLIC_DOTPROJECT_URL=
PUBLIC_DOA_LIBRARY_URL=
