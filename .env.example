# Koneksi database portal (dittek).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dittek

# Folder berkas dokumen (hasil `npm run mirror-files`). Kosong = ./files.
FILES_DIR=

# Alamat server portal lama (PHP) & sub-sistemnya. Opsional — kosong = default
# di src/lib/config/legacy.ts (server baru 10.1.95.116). Bila server pindah lagi,
# ganti di sini lalu restart (tanpa rebuild). PUBLIC_* ikut terkirim ke browser.
PUBLIC_LEGACY_PORTAL_URL=
PUBLIC_DOA_URL=
PUBLIC_DOTPROJECT_URL=
PUBLIC_DOA_LIBRARY_URL=
